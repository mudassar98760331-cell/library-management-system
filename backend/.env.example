PORT=5000
DB_HOST=localhost
DB_PORT=5432
DB_NAME=library_db
DB_USER=postgres
DB_PASSWORD=your_password_here
# Cloud database connection string (overrides DB_HOST/DB_PORT/DB_NAME/DB_USER/DB_PASSWORD)
# DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require
# DB_SSL=true
JWT_SECRET=generate_a_strong_random_secret_at_least_64_chars
ADMIN_EMAIL=admin@library.com
ADMIN_PASSWORD=generate_a_strong_random_password
CORS_ORIGIN=http://localhost:5173

# Email / OTP account activation (backend only — never commit real credentials)
# EMAIL_PROVIDER: smtp (production) | test (local file outbox for development) | empty (disabled)
EMAIL_PROVIDER=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASS=
EMAIL_API_KEY=
EMAIL_FROM=
EMAIL_FROM_NAME=Lakshya Library
OTP_EXPIRY_MINUTES=10
